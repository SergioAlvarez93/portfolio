# Обязательные секреты и идентификаторы
YANDEXGPT_API_KEY=
YANDEXGPT_CATALOG_ID=

# Bitrix24 incoming webhook URLs.
# Создайте новые вебхуки и укажите URL с новыми токенами.
BITRIX_WEBHOOK_GET=
BITRIX_WEBHOOK_LIST=
BITRIX_WEBHOOK_UPDATE=
BITRIX_WEBHOOK_USER=

# Необязательный резервный провайдер классификации.
# Если ключ не задан, fallback на OpenRouter отключён.
OPENROUTER_API_KEY=

# API endpoints and models
YANDEXGPT_BASE_URL=https://rest-assistant.api.cloud.yandex.net/v1
YANDEXGPT_MODEL=aliceai-llm/latest
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free

# Routing rules
MAIN_MANAGERS=12,286,1074
SPECIAL_MANAGER=1016
DEFAULT_MANAGER=1850
JUNK_STATUS_ID=JUNK

# Runtime
RETRY_ATTEMPTS=3
RETRY_DELAY=5
BITRIX_TIMEOUT=10
OPENROUTER_TIMEOUT=15
LOG_FILE=lead_distributor.log
LOG_LEVEL=INFO
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
